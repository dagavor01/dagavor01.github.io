<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>DAGAVOR GLOBAL - Wallet 45 Pays + Pub</title>
<script src="https://unpkg.com/@solana/web3.js@1.91.0/lib/index.iife.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bip39@3.1.0/dist/bip39.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ed25519-hd-key@1.3.0/dist/index.min.js"></script>
<style>
body{margin:0;background:#0a0614;color:#fff;font-family:Inter,Arial;padding:10px}
.header{max-width:480px;margin:auto;display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #1f1a30}
.logo{font-weight:900;background:linear-gradient(90deg,#FFD700,#ff8c00);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-size:20px}
.badge{background:#2a2340;color:#a48fff;padding:4px 10px;border-radius:20px;font-size:11px}
.card{max-width:480px;margin:15px auto;background:#15101f;border:1px solid #2a2340;border-radius:24px;padding:18px}
.tabs{display:flex;gap:8px;margin-bottom:12px}
.tab{flex:1;padding:10px;border-radius:12px;background:#0e0a1a;border:1px solid #2a2340;color:#888;cursor:pointer;text-align:center;font-size:13px;font-weight:700}
.tab.active{background:linear-gradient(90deg,#FFD700,#ff8c00);color:#000;border:0}
button{width:100%;padding:14px;border-radius:14px;border:0;font-weight:800;margin-top:8px;cursor:pointer}
.btn-gold{background:linear-gradient(90deg,#FFD700,#ff8c00);color:#000}.btn-green{background:linear-gradient(90deg,#00ff88,#00cc66);color:#000}.btn-dark{background:#0e0a1a;border:1px solid #2a2340;color:#fff}
.seed{background:#000;padding:12px;border-radius:12px;word-spacing:8px;line-height:28px;margin:10px 0;border:1px dashed #555}
.ad{background:linear-gradient(90deg,#111,#1a1500);border:1px solid #FFD700;border-radius:14px;padding:12px;text-align:center;margin:10px 0}
.input{width:100%;padding:14px;border-radius:14px;background:#0e0a1a;border:1px solid #2a2340;color:#fff;margin-top:8px;box-sizing:border-box}
select{width:100%;padding:12px;border-radius:14px;background:#0e0a1a;border:1px solid #2a2340;color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.box{background:#0e0a1a;border:1px solid #2a2340;border-radius:12px;padding:10px;text-align:center;font-size:11px}
#aiBtn{position:fixed;bottom:20px;right:20px;width:60px;height:60px;border-radius:50%;background:linear-gradient(90deg,#FFD700,#ff8c00);color:#000;font-size:28px;border:0}
#aiBox{position:fixed;bottom:90px;right:10px;width:350px;max-width:92%;background:#15101f;border:1px solid #2a2340;border-radius:16px;padding:12px;display:none;z-index:99}
small{color:#8b86a0} .section{display:none} .section.active{display:block}
</style></head><body>
<div class="header"><div class="logo">DAGAVOR GLOBAL</div><div class="badge">45 PAYS LIVE</div></div>

<div class="card">
<div class="tabs">
<div class="tab active" onclick="showTab('wallet')">💜 Wallet</div>
<div class="tab" onclick="showTab('pub')">🌍 Pub 25$</div>
<div class="tab" onclick="showTab('partner')">🤝 Partner 70%</div>
</div>

<!-- WALLET SECTION -->
<div id="wallet" class="section active">
<select id="countrySelect"><option>🇨🇲 Cameroun OM</option><option>🇨🇮 Côte d'Ivoire Wave</option><option>🇸🇳 Sénégal Wave</option><option>🇲🇱 Mali</option><option>🇧🇯 Bénin</option><option>🇨🇩 RDC</option><option>🇰🇪 Kenya</option><option>🇳🇬 Nigeria</option><option>🇫🇷 France Carte/PayPal</option><option>🇧🇪 Belgique</option><option>🇩🇪 Allemagne</option><option>🇬🇧 UK</option><option>🇺🇸 USA Zelle</option><option>🇨🇦 Canada</option><option>🇦🇪 Dubaï</option><option>🇦🇺 Australie</option></select>
<div id="step1"><button class="btn-gold" onclick="createWallet()">Créer Wallet Mondial</button><button class="btn-dark" onclick="document.getElementById('importBox').style.display='block'">Importer 12 mots</button><div id="importBox" style="display:none"><textarea id="importSeed" class="input" placeholder="12 mots"></textarea><button onclick="importWallet()">Importer</button></div><div style="background:#0e0a1a;padding:10px;border-radius:12px;margin-top:10px"><b>💰 Parrainage 20% Mondial</b><br><small id="refLink">Crée wallet pour ton lien</small></div></div>
<div id="step2" style="display:none"><p><b>⚠️ NOTE LES 12 MOTS</b></p><div id="seedPhrase" class="seed"></div><small id="walletAddr"></small><br><button class="btn-gold" onclick="document.getElementById('step2').style.display='none';document.getElementById('step3').style.display='block'">J'ai noté</button></div>
<div id="step3" style="display:none"><h3>Mon Wallet Global</h3><p id="addr2" style="font-size:11px;word-break:break-all"></p><p>Balance: <b id="balance2">...</b></p><input id="myRefLink" class="input" readonly><button class="btn-gold" onclick="depositOM()">Déposer OM 1.5% - 655 16 63 10</button><button class="btn-dark" onclick="swap()">Swap 0.85% -> 8nodJY...Y1mv</button><div id="momoBox" style="display:none;background:#000;padding:10px;border-radius:12px;margin-top:10px"></div></div>
<div class="ad"><b>🔥 PUB ACTIVE ICI</b><br><small>15,000 vues/semaine - Clique onglet Pub</small></div>
</div>

<!-- PUB SECTION -->
<div id="pub" class="section">
<div class="badge">STYLE SOLFLARE - PUB GLOBALE</div><h2>Pub dans 45 pays</h2><small>Vue sur tous les wallets DAGAVOR</small>
<div class="grid"><div class="box">👁️ 15k vues/sem</div><div class="box">🌍 45 pays</div><div class="box">💳 OM/SOL</div><div class="box">⚡ 5 min</div></div>
<div style="margin-top:12px;font-size:32px;font-weight:900">25$ <span style="font-size:14px;color:#888">/ 15,000 FCFA</span></div>
<input id="bizName" class="input" placeholder="Nom boutique"><input id="bizText" class="input" placeholder="Texte pub: Habits Paris - livraison Afrique"><input id="bizLink" class="input" placeholder="WhatsApp: wa.me/..."><div style="background:#000;border:1px dashed #FFD700;border-radius:12px;padding:12px;margin-top:10px;text-align:center" id="preview">Aperçu pub</div>
<button class="btn-gold" onclick="payOM()">📱 Payer Orange Money 15,000F - 655 16 63 10</button><button class="btn-dark" onclick="paySOL()">💜 Payer SOL -> 8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv</button>
<div style="background:#0e0a1a;border-radius:12px;padding:10px;margin-top:10px;font-size:12px"><b>OM:</b> +237 655 16 63 10<br><b>Code:</b> <span id="pubCode">DAGAVOR-PUB-XXXX</span><br><b>SOL:</b> 8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv</div>
</div>

<!-- PARTNER SECTION -->
<div id="partner" class="section">
<h3>🤝 Deviens Partner Mondial</h3><small>70% pour toi, 30% auto pour coffre maître DAGAVOR. Vends ton propre wallet dans 45 pays.</small>
<input id="partnerName" class="input" placeholder="Nom boutique"><input id="partnerWallet" class="input" placeholder="Ton adresse SOL (70%)"><button class="btn-green" onclick="createPartner()">Générer mon business mondial</button><p id="partnerCode" style="font-size:11px;word-break:break-all"></p>
<div style="background:#0e0a1a;padding:10px;border-radius:12px;margin-top:10px;font-size:12px"><b>Calcul:</b> 10 boutiques x 400$ = 4,000$ / mois pour toi. Tout auto vers ton SOL + 30% vers 8nodJY...Y1mv</div>
</div>

<div style="margin-top:12px"><a href="#" onclick="document.getElementById('cgv').style.display='block';return false"><small>📄 CGV Globales - OM 655166310 - Coffre 8nodJY...Y1mv</small></a><div id="cgv" style="display:none;background:#000;padding:10px;border-radius:12px;font-size:11px;color:#ccc">1.Non banque. 2.Frais 1.5% OM + 0.85% swap vers 8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv. 3.Parrainage 20%. 4.Partner 70/30. 5.Pub 25$. 6.12 mots local. OM: 655166310.</div></div>
</div>

<button id="aiBtn" onclick="toggleAI()">🤖</button><div id="aiBox"><h4 style="margin:0">DAGAVOR IA 45 Pays</h4><div id="aiChat" style="background:#000;height:140px;overflow:auto;padding:8px;border-radius:10px;margin:8px 0;font-size:12px">Salut ! Dis "20€ France->CM" ou "pub"</div><input id="aiInput" class="input" style="width:68%;display:inline-block" placeholder="Message..."><button onclick="askAI()" style="width:28%;display:inline-block;padding:14px;border-radius:12px">Go</button></div>

<script>
const DAGAVOR_FEE_WALLET="8nodJYtBdPN42L3tFFcUfQTYbv3jXhMqcMJSGe9sY1mv";const DAGAVOR_OM="+237 655 16 63 10";const RPC="https://api.mainnet-beta.solana.com";let currentKeypair=null;
function getRef(){return new URLSearchParams(window.location.search).get('ref')}
function showTab(t){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));document.getElementById(t).classList.add('active');event.target.classList.add('active')}
async function createWallet(){const m=bip39.generateMnemonic();const seed=await bip39.mnemonicToSeed(m);const d=ed25519_hd_key.derivePath("m/44'/501'/0'/0'",seed.toString('hex')).key;const kp=solanaWeb3.Keypair.fromSeed(d);currentKeypair=kp;document.getElementById('seedPhrase').innerText=m;document.getElementById('walletAddr').innerText=kp.publicKey.toBase58();document.getElementById('addr2').innerText=kp.publicKey.toBase58();document.getElementById('myRefLink').value=location.origin+location.pathname+"?ref="+kp.publicKey.toBase58();document.getElementById('step1').style.display='none';document.getElementById('step2').style.display='block';localStorage.setItem('dagavor_mnemonic',m);checkBalance(kp.publicKey.toBase58())}
async function importWallet(){const m=document.getElementById('importSeed').value.trim();if(!bip39.validateMnemonic(m))return alert('12 mots invalides');const seed=await bip39.mnemonicToSeed(m);const d=ed25519_hd_key.derivePath("m/44'/501'/0'/0'",seed.toString('hex')).key;const kp=solanaWeb3.Keypair.fromSeed(d);currentKeypair=kp;document.getElementById('addr2').innerText=kp.publicKey.toBase58();document.getElementById('myRefLink').value=location.origin+location.pathname+"?ref="+kp.publicKey.toBase58();document.getElementById('step1').style.display='none';document.getElementById('step3').style.display='block';checkBalance(kp.publicKey.toBase58())}
async function checkBalance(p){try{const c=new solanaWeb3.Connection(RPC);const b=await c.getBalance(new solanaWeb3.PublicKey(p));document.getElementById('balance2').innerText=(b/1e9).toFixed(4)+' SOL'}catch(e){}}
function depositOM(){const code='DAGAVOR-'+Math.floor(1000+Math.random()*9000);const ref=getRef();document.getElementById('momoBox').innerHTML=`Envoie <b>15,000F</b> sur OM <b>${DAGAVOR_OM}</b><br>Code: <b>${code}</b> ${ref?' Ref:'+ref.slice(0,6):''}`;document.getElementById('momoBox').style.display='block';alert('OM '+DAGAVOR_OM+' Code '+code)}
async function swap(){const a=prompt('Combien SOL ?');if(!a)return;const f=parseFloat(a)*0.0085;alert(`Swap ${a} SOL\nFrais ${f.toFixed(5)} -> ${DAGAVOR_FEE_WALLET}`)}
function createPartner(){const n=document.getElementById('partnerName').value;const w=document.getElementById('partnerWallet').value;if(!n||!w)return alert('Nom + adresse SOL');document.getElementById('partnerCode').innerHTML=`Bravo ${n}!<br>Lien: ${location.origin+location.pathname}?partner=${n}<br>70% ${w} / 30% ${DAGAVOR_FEE_WALLET}`;}
function payOM(){const c=document.getElementById('pubCode').innerText;if(!document.getElementById('bizText').value)return alert('Texte pub vide');alert('OM: 15,000F sur '+DAGAVOR_OM+' motif '+c)}function paySOL(){const c=document.getElementById('pubCode').innerText;alert('SOL: 0.15 SOL vers '+DAGAVOR_FEE_WALLET+' memo '+c)}
function toggleAI(){const b=document.getElementById('aiBox');b.style.display=b.style.display==='none'?'block':'none'}
function askAI(){const i=document.getElementById('aiInput');const c=document.getElementById('aiChat');if(!i.value)return;c.innerHTML+=`<br><b>Toi:</b> ${i.value}`;c.innerHTML+=`<br><b>IA:</b> OM ${DAGAVOR_OM} | Coffre ${DAGAVOR_FEE_WALLET.slice(0,6)}... | Code DAGAVOR-XXXX`;c.scrollTop=c.scrollHeight;i.value=''}
window.onload=async()=>{document.getElementById('pubCode').innerText='DAGAVOR-PUB-'+Math.floor(1000+Math.random()*9000);const s=localStorage.getItem('dagavor_mnemonic');if(s){const seed=await bip39.mnemonicToSeed(s);const d=ed25519_hd_key.derivePath("m/44'/501'/0'/0'",seed.toString('hex')).key;const kp=solanaWeb3.Keypair.fromSeed(d);document.getElementById('addr2').innerText=kp.publicKey.toBase58();document.getElementById('myRefLink').value=location.origin+location.pathname+"?ref="+kp.publicKey.toBase58();document.getElementById('step1').style.display='none';document.getElementById('step3').style.display='block';checkBalance(kp.publicKey.toBase58())}const ref=getRef();if(ref)document.getElementById('refLink').innerText="Parrain: "+ref.slice(0,10)+"...";document.getElementById('bizText').addEventListener('input',e=>{document.getElementById('preview').innerHTML='<b>'+(document.getElementById('bizName').value||'Boutique')+'</b><br>'+e.target.value})}
</script></body></html>
